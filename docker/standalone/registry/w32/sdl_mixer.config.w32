ARG_ENABLE('sdl_mixer', 'SDL2_mixer (JumPHP)', 'no');
if (PHP_SDL_MIXER != 'no') {
    jumphp_libs('sdl_mixer', ['SDL2_mixer-static.lib;SDL2_mixer.lib']);
    EXTENSION('sdl_mixer', 'src/effect_position.c src/effect_stereoreverse.c src/Mix_Music.c src/Mix_Chunk.c ' +
        'src/music.c src/mixer.c php_sdl_mixer.c', PHP_SDL_MIXER_SHARED, '/DZEND_ENABLE_STATIC_TSRMLS_CACHE=1');
    jumphp_includes('sdl_mixer');
    ADD_EXTENSION_DEP('sdl_mixer', 'sdl');
    AC_DEFINE('HAVE_SDL_MIXER', 1);
    AC_DEFINE('HAVE_SDL_MIXER_FEATURE', 1);
}
