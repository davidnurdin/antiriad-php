# Copy to .env (read by bin/jumphp). Everything is optional.

# relay server the games use (desktop: env var; browser: game.yaml net_url, or ?net= in the URL)
JUMPHP_NET_URL=ws://localhost:8090/ws
JUMPHP_RELAY_PORT=8090

# the game of this project (bin/jumphp init): default of bin/jumphp deploy, and `bin/jumphp` alone shows the help
JUMPHP_GAME=

# bin/jumphp deploy to your server (bin/jumphp deploy:setup asks for these)
JUMPHP_SERVER=                  # ssh target: user@host
JUMPHP_SERVER_DIR=              # default /opt/jumphp/<game>
JUMPHP_SERVER_MODE=             # frankenphp (alone, HTTPS by Let's Encrypt) | traefik (Traefik + FrankenPHP) | traefik-external
JUMPHP_DOMAIN=                  # game.example.com (its DNS record points to the server)
JUMPHP_ACME_EMAIL=              # Let's Encrypt account (frankenphp, traefik)
JUMPHP_DEPLOY_GAMES=            # several games on one domain: "game1 game2" (a home page + /game1/ /game2/)
JUMPHP_TRAEFIK_NETWORK=         # traefik-external: the Docker network, entry point and certificate resolver of that Traefik
JUMPHP_TRAEFIK_ENTRYPOINT=
JUMPHP_TRAEFIK_RESOLVER=

# bin/jumphp deploy <game> without JUMPHP_SERVER: rsync target (user@host:/var/www/games or a local folder with JUMPHP_DEPLOY_LOCAL=1)
JUMPHP_DEPLOY_TARGET=
JUMPHP_DEPLOY_LOCAL=

# force X11 even under Wayland (XWayland) when the Wayland window misbehaves
JUMPHP_X11=
