# Copy to .env (read by bin/jumphp). Everything is optional.

# relay server the games use (desktop: env var; browser: game.yaml net_url, or ?net= in the URL)
JUMPHP_NET_URL=ws://localhost:8090/ws
JUMPHP_RELAY_PORT=8090

# bin/jumphp deploy <game>: rsync target (user@host:/var/www/games or a local folder with JUMPHP_DEPLOY_LOCAL=1)
JUMPHP_DEPLOY_TARGET=
JUMPHP_DEPLOY_LOCAL=

# force X11 even under Wayland (XWayland) when the Wayland window misbehaves
JUMPHP_X11=
