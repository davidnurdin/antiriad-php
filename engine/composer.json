{
    "name": "jumphp/engine",
    "description": "JumPHP: a PHP engine for retro 2D games (SDL2) running natively and in the browser (WebAssembly).",
    "type": "library",
    "license": "MIT",
    "keywords": ["game", "engine", "sdl", "2d", "retro", "webassembly", "wasm", "tiles"],
    "require": {
        "php": ">=8.2",
        "davidnurdin/php-wasm-network": "dev-main#a898904e58d445501dc98e5d2cf029632c449618",
        "evenement/evenement": "^3.0",
        "laravel/serializable-closure": "^2.0",
        "react/event-loop": "^1.5",
        "symfony/config": "^7.2",
        "symfony/dependency-injection": "^7.2",
        "symfony/yaml": "^7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    },
    "repositories": [
        { "type": "vcs", "url": "https://github.com/davidnurdin/php-wasm-network" }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": { "JumPHP\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "JumPHP\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}
