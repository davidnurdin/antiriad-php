#!/usr/bin/env bash
# JumPHP command line: everything runs in Docker, the host only needs docker (and a display + sound
# server to play on desktop). `bin/jumphp help` lists the commands.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
[ -f .env ] && set -a && . ./.env && set +a

DESKTOP_IMAGE="${JUMPHP_DESKTOP_IMAGE:-jumphp/desktop:dev}"
# runtime "async" (game.yaml `runtime: async`): PHP 8.6 ZTS + TrueAsync (threads, coroutines)
ASYNC_IMAGE="${JUMPHP_ASYNC_IMAGE:-jumphp/desktop-async:dev}"
EMSDK_IMAGE="${JUMPHP_EMSDK_IMAGE:-emscripten/emsdk:3.1.35}"
WEB_IMAGE="${JUMPHP_WEB_IMAGE:-dunglas/frankenphp:1.12.7-alpine}"
PUPPETEER_IMAGE="${JUMPHP_PUPPETEER_IMAGE:-ghcr.io/puppeteer/puppeteer:24.10.0}"
TRAEFIK_IMAGE="${JUMPHP_TRAEFIK_IMAGE:-traefik:v3.7}"
# the JumPHP repository: prebuilt engines (GitHub releases), `bin/jumphp update`
REPO_URL="${JUMPHP_REPO:-https://github.com/davidnurdin/jumPhp.git}"
ENGINE_DIR="$ROOT/build/engine"
BUILDER="${JUMPHP_BUILDER:-jumphp-builder}"
TTY_FLAGS=$([ -t 0 ] && [ -t 1 ] && echo "-it" || echo "-i")

say()  { printf '\033[1;36m==> %s\033[0m\n' "$*" >&2; }
warn() { printf '\033[1;33m[!] %s\033[0m\n' "$*" >&2; }
die()  { printf '\033[1;31m[x] %s\033[0m\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
JumPHP - retro 2D games in PHP (SDL), desktop + browser. Everything runs in Docker.

Setup
  init                      interactive wizard: tools, your game, engine, server, GitHub, then Claude Code
                            (also what `bin/jumphp` alone runs in a project without a game yet)
  setup [async]             build the Docker images (desktop runtime, relay server; async: PHP 8.6 ZTS + TrueAsync)
  engine:download [version] download the prebuilt WebAssembly engine of this version (GitHub release)
  engine:build              build the WebAssembly engine (PHP + SDL -> build/engine, ~25 min once, cached)
  engine:pack               build/engine -> .build/jumphp-engine.tar.gz (+ .sha256), the release asset
  runtime:build             the shared engine of remote games (a games site) -> build/runtime
                            + .build/jumphp-runtime.tar.gz (+ .sha256), the release asset (docs/remote.md)
  runtime:download [version]  download it from the GitHub release instead
  update                    merge the newest JumPHP (git remote "jumphp") into the project
  doctor                    check docker, display, sound

Games (<game> = a folder of games/, e.g. pong)
  new <game> [title]        create games/<game> from skeleton/
  install <game>            composer install (engine linked from engine/)
  composer <game> <args>    any composer command in the game
  run <game>                play on desktop (window + sound)
  test <game>               lint + phpstan (if configured) + phpunit (if tests/) + headless smoke test
  shot <game> [frames] [out.png]   headless screenshot after N frames (default 120) -> var/screenshots/
  build <game>              browser build -> games/<game>/dist/web (static files)
  build:remote <game>       the game as a remote game (shared engine, files one by one) -> dist/remote
  serve <game> [port]       serve the browser build on http://localhost:<port> (default 8080)
  webshot <game> [seconds] [keys]  headless Chrome: load the browser build, play keys, screenshot, fail on errors
                            keys: JSON [[second, "ArrowDown"], [2, "Enter"]] -> dist/webshot.png
                            (serve / webshot: JUMPHP_WEB=remote uses dist/remote)
  export:desktop <game>     a Docker image that runs the game (jumphp/game-<game>)
  deploy [game...]          to your server (JUMPHP_SERVER in .env, see deploy:setup): browser builds + FrankenPHP
                            (alone or behind Traefik), docker compose up there. Default game: JUMPHP_GAME.
                            Without JUMPHP_SERVER: rsync dist/web to $JUMPHP_DEPLOY_TARGET/<game>/
  deploy:setup              ask the server, domain, web server (FrankenPHP / Traefik + FrankenPHP / existing Traefik)
  server:setup              install Docker on the server (ssh)
  server:logs               the server's web logs
  server:traefik [user@host]  looks for a Traefik on the server: network, entry points, certificate resolver in use
  github                    put the project on GitHub (gh), optionally GitHub Pages
  pages [game...]           build the games (default: all) + a home page, publish them on the gh-pages
                            branch of the git remote (GitHub Pages; the branch is replaced each time)

Engine
  test engine               engine unit tests + phpstan
  lint                      php -l + forbidden words check of the whole repository
  php <dir> <args>          php in the desktop image, from <dir> (repo-relative)

Network
  relay up|down|logs        the multiplayer relay server (ws://localhost:8090/ws)

Environment (headless runs): JUMPHP_SCENE, JUMPHP_SCENE_PARAMS, JUMPHP_INPUT, JUMPHP_MAX_FRAMES, JUMPHP_SHOT_EVERY
EOF
}

game_dir() {
  local g="${1:-}"
  [ -n "$g" ] || die "missing <game> (a folder of games/)"
  [ -d "$ROOT/games/$g" ] || die "games/$g does not exist (bin/jumphp new $g)"
  echo "games/$g"
}

# runtime of a game folder: JUMPHP_RUNTIME, else `runtime:` in its config/game.yaml, else "default"
game_runtime() {
  if [ -n "${JUMPHP_RUNTIME:-}" ]; then echo "$JUMPHP_RUNTIME"; return; fi
  local yaml="$ROOT/$1/config/game.yaml"
  if [ -f "$yaml" ] && grep -qE '^[[:space:]]*runtime:[[:space:]]*["'"'"']?async' "$yaml"; then echo async; else echo default; fi
}

runtime_image() { [ "$(game_runtime "$1")" = async ] && echo "$ASYNC_IMAGE" || echo "$DESKTOP_IMAGE"; }

ensure_desktop_image() {
  docker image inspect "$DESKTOP_IMAGE" >/dev/null 2>&1 || { say "building $DESKTOP_IMAGE (first time, ~3 min)"; docker build -t "$DESKTOP_IMAGE" --build-context ext=docker/ext docker/desktop; }
}

# php_run <workdir repo-relative> [docker flags...] -- <command...>
php_run() {
  local wd="$1"; shift
  local flags=()
  while [ $# -gt 0 ] && [ "$1" != "--" ]; do flags+=("$1"); shift; done
  [ "${1:-}" = "--" ] && shift
  local image; image="$(runtime_image "$wd")"
  if [ "$image" = "$ASYNC_IMAGE" ]; then
    docker image inspect "$ASYNC_IMAGE" >/dev/null 2>&1 || { say "building $ASYNC_IMAGE (PHP 8.6 ZTS + TrueAsync, first time ~15 min)"; docker build -t "$ASYNC_IMAGE" --build-context ext=docker/ext docker/desktop-async; }
  else
    ensure_desktop_image
  fi
  docker run --rm $TTY_FLAGS --user "$(id -u):$(id -g)" \
    -v "$ROOT:/workspace" -w "/workspace/$wd" \
    -e HOME=/tmp -e COMPOSER_HOME=/tmp/composer -e COMPOSER_CACHE_DIR=/workspace/.cache/composer \
    ${flags[@]+"${flags[@]}"} "$image" "$@"
}

# headless OpenGL: JUMPHP_GL=1|0, else on when the game's code uses the engine's gl() / opengl().
# The run gets a real window on Xvfb (Mesa llvmpipe) instead of the SDL dummy driver.
gl_flags() {
  local on="${JUMPHP_GL:-}"
  [ -n "$on" ] || { grep -rqE -- '->(gl|opengl)\(\)' "$ROOT/$1/src" 2>/dev/null && on=1 || on=0; }
  [ "$on" = 1 ] && echo "-e JUMPHP_HEADLESS_GL=1 -e SDL_VIDEODRIVER=x11"
}
gl_wrap() { [ -n "$(gl_flags "$1")" ] && echo "jumphp-xvfb"; }   # docker/ext/jumphp-xvfb

ensure_vendor() {
  local dir="$1"
  if [ ! -f "$ROOT/$dir/vendor/autoload.php" ]; then
    say "composer install ($dir)"
    php_run "$dir" -- composer install --no-interaction --no-progress
  fi
}

cmd_setup() {
  say "desktop runtime image ($DESKTOP_IMAGE)"
  docker build -t "$DESKTOP_IMAGE" --build-context ext=docker/ext docker/desktop
  say "relay server image"
  docker compose build relay
  if [ "${1:-}" = async ]; then
    say "async runtime image ($ASYNC_IMAGE: PHP 8.6 ZTS + TrueAsync, ~15 min)"
    docker build -t "$ASYNC_IMAGE" --build-context ext=docker/ext docker/desktop-async
  fi
  say "done. Next: bin/jumphp engine:build (browser engine), bin/jumphp run pong"
}

cmd_engine_build() {
  docker buildx inspect "$BUILDER" >/dev/null 2>&1 || docker buildx create --name "$BUILDER" --driver docker-container >/dev/null
  say "building the WebAssembly engine (first build ~25 min, then cached in .cache/buildx-engine)"
  docker buildx bake --builder "$BUILDER" -f docker/engine-wasm/docker-bake.hcl --progress=plain "$@"
  ls -la "$ENGINE_DIR"
}

# The prebuilt engine of a version (asset of the GitHub release vX.Y.Z), checked with its sha256.
cmd_engine_download() {
  local version="${1:-$(cat "$ROOT/VERSION" 2>/dev/null || echo latest)}"
  local base="${REPO_URL%.git}/releases" url
  if [ "$version" = latest ]; then url="$base/latest/download"; else url="$base/download/v${version#v}"; fi
  command -v curl >/dev/null || die "curl is needed"
  local tmp; tmp="$(mktemp -d)"
  say "downloading the engine $version ($url/jumphp-engine.tar.gz)"
  curl -fL --progress-bar -o "$tmp/jumphp-engine.tar.gz" "$url/jumphp-engine.tar.gz" \
    && curl -fsSL -o "$tmp/jumphp-engine.tar.gz.sha256" "$url/jumphp-engine.tar.gz.sha256" \
    || { rm -rf "$tmp"; die "no prebuilt engine for $version: bin/jumphp engine:build (~25 min)"; }
  local want got
  want="$(cut -d' ' -f1 < "$tmp/jumphp-engine.tar.gz.sha256")"
  got="$( (sha256sum "$tmp/jumphp-engine.tar.gz" 2>/dev/null || shasum -a 256 "$tmp/jumphp-engine.tar.gz") | cut -d' ' -f1)"
  [ -n "$want" ] && [ "$want" = "$got" ] || { rm -rf "$tmp"; die "checksum mismatch: the download is broken, try again"; }
  mkdir -p "$ENGINE_DIR"
  tar -xzf "$tmp/jumphp-engine.tar.gz" -C "$ENGINE_DIR"
  rm -rf "$tmp"
  ls -la "$ENGINE_DIR"
}

cmd_engine_pack() {
  [ -f "$ENGINE_DIR/php-web.wasm" ] || die "no engine: bin/jumphp engine:build first"
  mkdir -p "$ROOT/.build"
  tar -czf "$ROOT/.build/jumphp-engine.tar.gz" -C "$ENGINE_DIR" .
  (cd "$ROOT/.build" && { sha256sum jumphp-engine.tar.gz 2>/dev/null || shasum -a 256 jumphp-engine.tar.gz; } > jumphp-engine.tar.gz.sha256)
  ls -la "$ROOT/.build/jumphp-engine.tar.gz"*
}

# The shared engine of remote games (docs/remote.md): build/runtime, and its release asset.
cmd_runtime_build() {
  [ -f "$ENGINE_DIR/php-web.mjs" ] && [ -f "$ENGINE_DIR/php-web.wasm" ] || die "no engine in build/engine: bin/jumphp engine:download (or engine:build) first"
  php_run . -- sh /workspace/tools/build-runtime.sh
  mkdir -p "$ROOT/.build"
  tar -czf "$ROOT/.build/jumphp-runtime.tar.gz" -C "$ROOT/build/runtime" .
  (cd "$ROOT/.build" && { sha256sum jumphp-runtime.tar.gz 2>/dev/null || shasum -a 256 jumphp-runtime.tar.gz; } > jumphp-runtime.tar.gz.sha256)
  say "done: build/runtime (+ .build/jumphp-runtime.tar.gz)"
}

cmd_runtime_download() {
  local version="${1:-$(cat "$ROOT/VERSION" 2>/dev/null || echo latest)}"
  local base="${REPO_URL%.git}/releases" url
  if [ "$version" = latest ]; then url="$base/latest/download"; else url="$base/download/v${version#v}"; fi
  local tmp; tmp="$(mktemp -d)"
  say "downloading the runtime $version ($url/jumphp-runtime.tar.gz)"
  curl -fL --progress-bar -o "$tmp/r.tar.gz" "$url/jumphp-runtime.tar.gz" \
    && curl -fsSL -o "$tmp/r.sha256" "$url/jumphp-runtime.tar.gz.sha256" \
    || { rm -rf "$tmp"; die "no runtime for $version: bin/jumphp runtime:build"; }
  local want got
  want="$(cut -d' ' -f1 < "$tmp/r.sha256")"
  got="$( (sha256sum "$tmp/r.tar.gz" 2>/dev/null || shasum -a 256 "$tmp/r.tar.gz") | cut -d' ' -f1)"
  [ -n "$want" ] && [ "$want" = "$got" ] || { rm -rf "$tmp"; die "checksum mismatch: the download is broken, try again"; }
  rm -rf "$ROOT/build/runtime" && mkdir -p "$ROOT/build/runtime"
  tar -xzf "$tmp/r.tar.gz" -C "$ROOT/build/runtime"
  rm -rf "$tmp"
  ls -la "$ROOT/build/runtime"
}

# The newest JumPHP merged into the project (a project made by composer create-project or bin/jumphp init
# has the framework as git remote "jumphp"; a plain clone of JumPHP has it as origin).
cmd_update() {
  command -v git >/dev/null || die "git is needed"
  local remote=jumphp
  git -C "$ROOT" remote get-url jumphp >/dev/null 2>&1 || {
    if git -C "$ROOT" remote get-url origin 2>/dev/null | grep -q 'davidnurdin/jumPhp'; then remote=origin
    else git -C "$ROOT" remote add jumphp "$REPO_URL"; fi
  }
  [ -z "$(git -C "$ROOT" status --porcelain)" ] || die "commit your changes first (git status)"
  say "merging $remote/main"
  git -C "$ROOT" pull --no-rebase --no-edit "$remote" main
  say "updated. The engine changed? bin/jumphp engine:download (or engine:build); then bin/jumphp setup"
}

cmd_new() {
  local name="${1:-}" title="${2:-}"
  [[ "$name" =~ ^[a-z][a-z0-9-]*$ ]] || die "game name: lower case letters, digits and dashes (e.g. space-race)"
  [ -e "games/$name" ] && die "games/$name already exists"
  [ -n "$title" ] || title="$(echo "$name" | tr '-' ' ' | tr '[:lower:]' '[:upper:]')"
  mkdir -p games
  cp -r skeleton "games/$name"
  php_run "games/$name" -- php /workspace/tools/new-game.php "$name" "$title"
  say "games/$name created. Next: bin/jumphp install $name && bin/jumphp run $name"
}

cmd_run() {
  local dir; dir="$(game_dir "${1:-}")"
  ensure_vendor "$dir"
  local flags=(--network host -e "JUMPHP_NET_URL=${JUMPHP_NET_URL:-}" -e "JUMPHP_DEBUG=${JUMPHP_DEBUG:-}"
               -e "JUMPHP_MAX_FRAMES=${JUMPHP_MAX_FRAMES:-}" -e "JUMPHP_SCENE=${JUMPHP_SCENE:-}" -e "JUMPHP_SCENE_PARAMS=${JUMPHP_SCENE_PARAMS:-}")
  local xdg="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "$xdg/$WAYLAND_DISPLAY" ] && [ "${JUMPHP_X11:-}" != 1 ]; then
    flags+=(-e XDG_RUNTIME_DIR=/tmp/xdg -e "WAYLAND_DISPLAY=$WAYLAND_DISPLAY" -e SDL_VIDEODRIVER=wayland
            -v "$xdg/$WAYLAND_DISPLAY:/tmp/xdg/$WAYLAND_DISPLAY")
  elif [ -n "${DISPLAY:-}" ]; then
    flags+=(-e "DISPLAY=$DISPLAY" -v /tmp/.X11-unix:/tmp/.X11-unix:ro -e SDL_VIDEODRIVER=x11)
    if [ -n "${XAUTHORITY:-}" ] && [ -f "$XAUTHORITY" ]; then
      flags+=(-v "$XAUTHORITY:/tmp/.Xauthority:ro" -e XAUTHORITY=/tmp/.Xauthority)
    elif [ -f "$HOME/.Xauthority" ]; then
      flags+=(-v "$HOME/.Xauthority:/tmp/.Xauthority:ro" -e XAUTHORITY=/tmp/.Xauthority)
    fi
  else
    die "no display (DISPLAY / WAYLAND_DISPLAY). Headless: bin/jumphp test $1 or bin/jumphp shot $1"
  fi
  if [ -S "$xdg/pulse/native" ]; then
    flags+=(-v "$xdg/pulse/native:/tmp/pulse-native" -e PULSE_SERVER=unix:/tmp/pulse-native)
    [ -f "$HOME/.config/pulse/cookie" ] && flags+=(-v "$HOME/.config/pulse/cookie:/tmp/pulse-cookie:ro" -e PULSE_COOKIE=/tmp/pulse-cookie)
  else
    warn "no PulseAudio/PipeWire socket at $xdg/pulse/native: no sound"
    flags+=(-e SDL_AUDIODRIVER=dummy)
  fi
  if [ -d /dev/dri ]; then
    flags+=(--device /dev/dri)
    for grp in video render; do
      local gid; gid="$(getent group "$grp" | cut -d: -f3 || true)"
      [ -n "$gid" ] && flags+=(--group-add "$gid")
    done
  fi
  php_run "$dir" "${flags[@]}" -- php app.php
}

cmd_test() {
  local target="${1:-}"
  if [ "$target" = "engine" ]; then
    ensure_vendor engine
    say "engine: phpunit"
    php_run engine -e SDL_VIDEODRIVER=dummy -e SDL_AUDIODRIVER=dummy -- vendor/bin/phpunit
    say "engine: phpstan"
    php_run engine -- vendor/bin/phpstan analyse --no-progress --memory-limit=1G
    return
  fi
  local dir; dir="$(game_dir "$target")"
  ensure_vendor "$dir"
  say "$dir: php -l"
  php_run "$dir" -- sh -c 'find src app.php -name "*.php" -print0 | xargs -0 -n1 php -l >/dev/null'
  if [ -f "$ROOT/$dir/phpstan.neon" ] && [ -x "$ROOT/engine/vendor/bin/phpstan" ]; then
    say "$dir: phpstan"
    php_run "$dir" -- /workspace/engine/vendor/bin/phpstan analyse --no-progress --memory-limit=1G
  fi
  if [ -d "$ROOT/$dir/tests" ] && [ -x "$ROOT/engine/vendor/bin/phpunit" ]; then
    say "$dir: phpunit"
    php_run "$dir" -e SDL_VIDEODRIVER=dummy -e SDL_AUDIODRIVER=dummy -- /workspace/engine/vendor/bin/phpunit --bootstrap vendor/autoload.php tests
  fi
  say "$dir: headless smoke test (${JUMPHP_MAX_FRAMES:-600} frames$([ -n "$(gl_flags "$dir")" ] && echo ', OpenGL on Xvfb'))"
  # shellcheck disable=SC2046
  php_run "$dir" $(gl_flags "$dir") -e JUMPHP_SMOKE=1 -e "JUMPHP_MAX_FRAMES=${JUMPHP_MAX_FRAMES:-600}" \
    -e "JUMPHP_SCENE=${JUMPHP_SCENE:-}" -e "JUMPHP_SCENE_PARAMS=${JUMPHP_SCENE_PARAMS:-}" -e "JUMPHP_INPUT=${JUMPHP_INPUT:-}" \
    -- $(gl_wrap "$dir") php app.php
  say "$dir: all checks passed"
}

cmd_shot() {
  local dir; dir="$(game_dir "${1:-}")"
  local frames="${2:-120}" out="${3:-var/screenshots/shot.png}"
  ensure_vendor "$dir"
  rm -f "$ROOT/$dir/${out%.png}"-[0-9]*.png   # frames of an earlier JUMPHP_SHOT_EVERY run
  # shellcheck disable=SC2046
  php_run "$dir" $(gl_flags "$dir") -e "JUMPHP_SCREENSHOT=$out" -e "JUMPHP_MAX_FRAMES=$frames" -e "JUMPHP_SHOT_EVERY=${JUMPHP_SHOT_EVERY:-0}" \
    -e "JUMPHP_SCENE=${JUMPHP_SCENE:-}" -e "JUMPHP_SCENE_PARAMS=${JUMPHP_SCENE_PARAMS:-}" -e "JUMPHP_INPUT=${JUMPHP_INPUT:-}" \
    -- $(gl_wrap "$dir") php app.php
  echo "$ROOT/$dir/$out"
}

cmd_build() {
  local game="${1:-}"; local dir; dir="$(game_dir "$game")"
  [ -f "$ENGINE_DIR/php-web.mjs" ] && [ -f "$ENGINE_DIR/php-web.wasm" ] || die "no engine in build/engine: bin/jumphp engine:build first"
  say "staging $dir (composer --no-dev, container dump)"
  php_run "$dir" -- sh /workspace/tools/stage-web.sh "/workspace/$dir"
  say "packaging (emscripten file_packager) -> $dir/dist/web"
  docker run --rm --user "$(id -u):$(id -g)" -v "$ROOT:/workspace" -w /workspace "$EMSDK_IMAGE" \
    sh /workspace/tools/package-web.sh "/workspace/$dir"
  say "done: $dir/dist/web ($(du -sh "$ROOT/$dir/dist/web" | cut -f1)). Try it: bin/jumphp serve $game"
}

# A remote game (docs/remote.md) in dist/remote: the runtime in engine/, the game's files, manifest, page.
cmd_build_remote() {
  local game="${1:-}"; local dir; dir="$(game_dir "$game")"
  [ -f "$ROOT/build/runtime/version.json" ] || cmd_runtime_build
  [ -f "$ROOT/$dir/vendor/autoload.php" ] || php_run "$dir" -- composer install --no-interaction
  rm -rf "$ROOT/$dir/dist/remote"
  php_run "$dir" -- php /workspace/tools/remote-manifest.php "/workspace/$dir" "/workspace/$dir/dist/remote" engine/ /workspace/build/runtime
  cp -r "$ROOT/build/runtime" "$ROOT/$dir/dist/remote/engine"
  say "done: $dir/dist/remote. Try it: JUMPHP_WEB=remote bin/jumphp serve $game"
}

cmd_serve() {
  local dir; dir="$(game_dir "${1:-}")"
  local port="${2:-8080}" web="${JUMPHP_WEB:-web}"
  [ -f "$ROOT/$dir/dist/$web/index.html" ] || die "no browser build: bin/jumphp build ${1}"
  say "http://localhost:$port/  (Ctrl+C to stop)"
  docker run --rm $TTY_FLAGS -p "127.0.0.1:$port:80" -v "$ROOT/$dir/dist/$web:/srv:ro" \
    -v "$ROOT/docker/web/Caddyfile:/etc/frankenphp/Caddyfile:ro" "$WEB_IMAGE"
}

cmd_webshot() {
  local game="${1:-}"; local dir; dir="$(game_dir "$game")"
  local seconds="${2:-8}" keys="${3:-[]}" web="${JUMPHP_WEB:-web}"
  [ -f "$ROOT/$dir/dist/$web/index.html" ] || die "no browser build: bin/jumphp build $game"
  local name="jumphp-webshot-$game" port="${JUMPHP_WEBSHOT_PORT:-18999}"
  docker rm -f "$name" >/dev/null 2>&1 || true
  docker run -d --name "$name" -p "127.0.0.1:$port:80" -v "$ROOT/$dir/dist/$web:/srv:ro" \
    -v "$ROOT/docker/web/Caddyfile:/etc/frankenphp/Caddyfile:ro" "$WEB_IMAGE" >/dev/null
  trap 'docker rm -f "'"$name"'" >/dev/null 2>&1 || true' EXIT
  sleep 1
  chmod 777 "$ROOT/$dir/dist"
  local status=0
  docker run --rm --network host --init -v "$ROOT/tools/webshot:/scripts:ro" -v "$ROOT/$dir/dist:/out" -w /home/pptruser \
    "$PUPPETEER_IMAGE" sh -c "cp /scripts/webshot.cjs . && node webshot.cjs http://127.0.0.1:$port/ /out/webshot.png '$seconds' '$keys'" \
    2>&1 | grep -vE 'GPU stall|Automatic fallback|ScriptProcessorNode' || status=1
  [ -f "$ROOT/$dir/dist/webshot.png" ] && echo "$ROOT/$dir/dist/webshot.png"
  return $status
}

cmd_relay() {
  case "${1:-up}" in
    up) docker compose up -d --build relay && say "relay on ws://localhost:${JUMPHP_RELAY_PORT:-8090}/ws" ;;
    down) docker compose stop relay ;;
    logs) docker compose logs -f relay ;;
    *) die "relay up|down|logs" ;;
  esac
}

cmd_export_desktop() {
  local game="${1:-}"; local dir; dir="$(game_dir "$game")"
  ensure_desktop_image
  php_run "$dir" -- sh /workspace/tools/stage-web.sh "/workspace/$dir"
  docker build -t "jumphp/game-$game" -f docker/desktop/Dockerfile.game --build-arg "BASE=$(runtime_image "$(game_dir "$game")")" ".build/$game"
  say "image jumphp/game-$game. Run it with the same flags as bin/jumphp run (display + sound), e.g.:"
  echo "  docker run --rm -e DISPLAY -v /tmp/.X11-unix:/tmp/.X11-unix jumphp/game-$game"
}

cmd_deploy() {
  if [ -n "${JUMPHP_SERVER:-}" ]; then cmd_server_deploy "$@"; return; fi
  local game="${1:-${JUMPHP_GAME:-}}"; local dir; dir="$(game_dir "$game")"
  [ -n "${JUMPHP_DEPLOY_TARGET:-}" ] || die "no server: bin/jumphp deploy:setup (or JUMPHP_DEPLOY_TARGET in .env for a plain rsync)"
  [ -f "$ROOT/$dir/dist/web/index.html" ] || die "no browser build: bin/jumphp build $game"
  say "rsync $dir/dist/web -> $JUMPHP_DEPLOY_TARGET/$game/"
  docker run --rm -v "$ROOT/$dir/dist/web:/src:ro" -v "${SSH_AUTH_SOCK:-/dev/null}:/ssh-agent" -e SSH_AUTH_SOCK=/ssh-agent \
    -v "$HOME/.ssh/known_hosts:/root/.ssh/known_hosts:ro" \
    ${JUMPHP_DEPLOY_LOCAL:+-v "$JUMPHP_DEPLOY_TARGET:$JUMPHP_DEPLOY_TARGET"} \
    instrumentisto/rsync-ssh rsync -az --delete /src/ "$JUMPHP_DEPLOY_TARGET/$game/"
}

server_dir() { echo "${JUMPHP_SERVER_DIR:-/opt/jumphp/${JUMPHP_GAME:-site}}"; }

# Your server (bin/jumphp deploy:setup): the browser builds in site/ (one game at the root, several: a home page
# + <game>/), the compose file of the mode (docker/server/<mode>), its .env; rsync, then docker compose up there.
cmd_server_deploy() {
  local target="$JUMPHP_SERVER" mode="${JUMPHP_SERVER_MODE:-frankenphp}" dir; dir="$(server_dir)"
  [ -n "${JUMPHP_DOMAIN:-}" ] || die "JUMPHP_DOMAIN is empty: bin/jumphp deploy:setup"
  [ -d "$ROOT/docker/server/$mode" ] || die "JUMPHP_SERVER_MODE: frankenphp, traefik, traefik-external or traefik-passthrough"
  command -v rsync >/dev/null && command -v ssh >/dev/null || die "rsync and ssh are needed (bin/jumphp deploy:setup installs them)"
  local games=("$@")
  # shellcheck disable=SC2206
  [ ${#games[@]} -gt 0 ] || games=(${JUMPHP_DEPLOY_GAMES:-${JUMPHP_GAME:-}})
  [ ${#games[@]} -gt 0 ] || die "which game? bin/jumphp deploy <game> (or JUMPHP_GAME in .env)"

  local out="$ROOT/.build/server"
  rm -rf "$out" && mkdir -p "$out/site"
  for game in "${games[@]}"; do game_dir "$game" >/dev/null; cmd_build "$game"; done
  local pages="$ROOT/games/${games[0]}/site"
  if [ ${#games[@]} -eq 1 ] && [ -f "$pages/index.html" ]; then
    # the game's own web site (games/<id>/site/) at the root, the game in play/; {{DOMAIN}} in its pages
    cp -r "$pages/." "$out/site/"
    cp -r "$ROOT/games/${games[0]}/dist/web" "$out/site/play"
    (cd "$pages" && find . -type f \( -name '*.html' -o -name '*.xml' -o -name '*.txt' -o -name '*.json' -o -name '*.webmanifest' \)) |
      while read -r file; do
        sed "s#{{DOMAIN}}#$JUMPHP_DOMAIN#g" "$pages/$file" > "$out/site/$file"
      done
  elif [ ${#games[@]} -eq 1 ]; then
    cp -r "$ROOT/games/${games[0]}/dist/web/." "$out/site/"
  else
    for game in "${games[@]}"; do cp -r "$ROOT/games/$game/dist/web" "$out/site/$game"; done
    php_run . -- php tools/pages-index.php .build/server/site "" "${games[@]}"
  fi
  cp "$ROOT/docker/server/$mode/compose.yaml" "$out/compose.yaml"
  # modes where FrankenPHP gets the certificate itself: the Caddyfile with the domain
  if [ "$mode" = frankenphp ] || [ "$mode" = traefik-passthrough ]; then
    # Caddy refuses an empty "email": without a Let's Encrypt address the line goes
    if [ -n "${JUMPHP_ACME_EMAIL:-}" ]; then cp "$ROOT/docker/server/frankenphp/Caddyfile" "$out/Caddyfile"
    else grep -v '^[[:space:]]*email {\$ACME_EMAIL}' "$ROOT/docker/server/frankenphp/Caddyfile" > "$out/Caddyfile"; fi
  else cp "$ROOT/docker/web/Caddyfile" "$out/Caddyfile"; fi
  local id; id="$(printf '%s' "${JUMPHP_GAME:-${games[0]}}" | tr -c 'a-z0-9\n' '-')"
  cat > "$out/.env" <<ENV
COMPOSE_PROJECT_NAME=jumphp-$id
JUMPHP_ID=jumphp-$id
JUMPHP_DOMAIN=$JUMPHP_DOMAIN
JUMPHP_ACME_EMAIL=${JUMPHP_ACME_EMAIL:-}
JUMPHP_WEB_IMAGE=$WEB_IMAGE
JUMPHP_TRAEFIK_IMAGE=$TRAEFIK_IMAGE
JUMPHP_TRAEFIK_NETWORK=${JUMPHP_TRAEFIK_NETWORK:-traefik}
JUMPHP_TRAEFIK_ENTRYPOINT=${JUMPHP_TRAEFIK_ENTRYPOINT:-websecure}
JUMPHP_TRAEFIK_HTTP_ENTRYPOINT=${JUMPHP_TRAEFIK_HTTP_ENTRYPOINT:-web}
JUMPHP_TRAEFIK_RESOLVER=${JUMPHP_TRAEFIK_RESOLVER:-letsencrypt}
ENV

  say "sending ${games[*]} to $target:$dir ($mode)"
  ssh -n "$target" "mkdir -p '$dir' 2>/dev/null || { sudo mkdir -p '$dir' && sudo chown \"\$(id -un)\" '$dir'; }" \
    || die "ssh $target failed (bin/jumphp deploy:setup)"
  local changed
  changed="$(rsync -azc --delete -i "$out/" "$target:$dir/" | grep -E ' (compose\.yaml|Caddyfile|\.env)$' || true)"
  local up="docker compose up -d --remove-orphans"
  [ -z "$changed" ] || up="$up --force-recreate"     # a new configuration: restart the containers
  ssh -n "$target" "cd '$dir' && $up" || die "docker compose failed on the server (Docker installed? bin/jumphp server:setup)"
  check_online "$target" "$dir" "$mode"
}

# After a deploy: waits (2 min at most) for https://<domain>/ to answer with a valid certificate; otherwise shows why.
check_online() {
  local target="$1" dir="$2" mode="$3" url="https://$JUMPHP_DOMAIN/" i
  command -v curl >/dev/null || { say "online: $url"; return 0; }
  say "waiting for $url (the first time, the certificate is being issued)"
  for i in $(seq 1 24); do
    if curl -fsS -o /dev/null -m 10 -A jumphp-deploy "$url" 2>/dev/null; then say "online: $url"; return 0; fi
    sleep 5
  done
  warn "$url does not answer with a valid certificate after 2 minutes. On the server:"
  ssh -n "$target" "cd '$dir' && docker compose ps && docker compose logs --tail 15" || true
  case "$mode" in
    traefik-external) warn "behind a Traefik: are JUMPHP_TRAEFIK_ENTRYPOINT / _RESOLVER the ones of that Traefik?" \
      "bin/jumphp server:traefik shows them; without a working resolver: JUMPHP_SERVER_MODE=traefik-passthrough" ;;
    traefik-passthrough) warn "behind a Traefik: are JUMPHP_TRAEFIK_ENTRYPOINT (:443) and JUMPHP_TRAEFIK_HTTP_ENTRYPOINT (:80) the ones of that Traefik? (bin/jumphp server:traefik)" ;;
    *) warn "does the DNS of $JUMPHP_DOMAIN point to the server, are its ports 80 and 443 open?" ;;
  esac
  return 1
}

# Docker on the server (Docker's official install script), the ssh user in the docker group.
cmd_server_setup() {
  [ -n "${JUMPHP_SERVER:-}" ] || die "no server: bin/jumphp deploy:setup"
  say "installing Docker on $JUMPHP_SERVER"
  ssh -t "$JUMPHP_SERVER" 'S=""; [ "$(id -u)" = 0 ] || S=sudo;
    if ! command -v docker >/dev/null; then curl -fsSL https://get.docker.com -o /tmp/get-docker.sh && $S sh /tmp/get-docker.sh; fi;
    [ "$(id -u)" = 0 ] || $S usermod -aG docker "$(id -un)"; docker compose version || $S docker compose version'
}

cmd_server_logs() {
  [ -n "${JUMPHP_SERVER:-}" ] || die "no server: bin/jumphp deploy:setup"
  ssh -t "$JUMPHP_SERVER" "cd '$(server_dir)' && docker compose logs -f --tail 100"
}

# A Traefik already running on the server, as key=value lines (read by the wizard): its container, Docker network,
# entry points on :80 (http=) and :443 (https=), the certificate resolver the other sites use (resolver=, empty:
# none, so Traefik can not issue certificates: traefik-passthrough), and the mode to use (mode=).
cmd_server_traefik() {
  local target="${1:-${JUMPHP_SERVER:-}}"
  [ -n "$target" ] || die "no server: bin/jumphp server:traefik user@host (or JUMPHP_SERVER in .env)"
  ssh -o BatchMode=yes -o ConnectTimeout=10 "$target" 'sh -s' <<'REMOTE'
c="$(docker ps --format '{{.Names}} {{.Image}}' 2>/dev/null | awk '$2 ~ /traefik/ {print $1; exit}')"
[ -n "$c" ] || { echo "traefik="; exit 0; }
echo "traefik=$c"
echo "network=$(docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' "$c" | awk '{print $1}')"
# the static configuration: command line arguments, then the mounted .toml / .yml files
{ docker inspect -f '{{range .Args}}{{println .}}{{end}}' "$c"
  for f in $(docker inspect -f '{{range .Mounts}}{{.Source}} {{end}}' "$c"); do
    case "$f" in *.toml|*.yml|*.yaml) [ -f "$f" ] && cat "$f" ;; esac
  done
} | awk '
  tolower($0) ~ /entrypoints\.[a-z0-9_-]+\.address/ {
    s = $0; sub(/.*[eE]ntry[pP]oints\./, "", s); name = s; sub(/\..*/, "", name)
    port = s; sub(/.*:/, "", port); gsub(/[^0-9]/, "", port); print port " " name; next }
  tolower($0) ~ /^[ \t]*\[entrypoints\.[a-z0-9_-]+\]/ {
    s = $0; sub(/.*[eE]ntry[pP]oints\./, "", s); sub(/\].*/, "", s); name = s; next }
  /^[ \t]+[A-Za-z0-9_-]+:[ \t]*$/ { s = $0; gsub(/[ \t:]/, "", s); yname = s; next }
  tolower($0) ~ /address/ && /:[0-9]+/ {
    port = $0; sub(/.*:/, "", port); gsub(/[^0-9]/, "", port)
    n = name != "" ? name : yname; if (n != "") print port " " n; name = "" }
' | awk '$1 == 80 && !h {print "http=" $2; h = 1} $1 == 443 && !s {print "https=" $2; s = 1}'
# a resolver is only trusted when another site uses it (a resolver can be declared and still not work)
labels="$(docker ps -q | xargs -r docker inspect -f '{{range $k, $v := .Config.Labels}}{{$k}}={{$v}}{{println}}{{end}}')"
resolver="$(printf '%s\n' "$labels" | sed -n 's/^traefik\.http\.routers\.[^.]*\.tls\.certresolver=//p' | sort | uniq -c | sort -rn | awk '{print $2; exit}')"
echo "resolver=$resolver"
if [ -n "$resolver" ]; then echo "mode=traefik-external"; else echo "mode=traefik-passthrough"; fi
REMOTE
}

# Static site of several games on GitHub Pages: <site>/index.html + <site>/<game>/ (browser builds), pushed as
# the only commit of the gh-pages branch (a deploy branch: its history is replaced each time).
# JUMPHP_PAGES_REMOTE (origin) / JUMPHP_PAGES_BRANCH (gh-pages) change where it goes.
cmd_pages() {
  command -v git >/dev/null || die "git is needed on the host for bin/jumphp pages"
  local remote="${JUMPHP_PAGES_REMOTE:-origin}" branch="${JUMPHP_PAGES_BRANCH:-gh-pages}" url
  url="$(git -C "$ROOT" remote get-url "$remote" 2>/dev/null)" || die "no git remote '$remote' (git remote add $remote <url>)"
  [ -f "$ENGINE_DIR/php-web.wasm" ] || die "no browser engine: bin/jumphp engine:build first (~25 min once)"
  local games=("$@")
  if [ ${#games[@]} -eq 0 ]; then
    for d in "$ROOT"/games/*/; do [ -f "$d/config/game.yaml" ] && games+=("$(basename "$d")"); done
  fi
  [ ${#games[@]} -gt 0 ] || die "no game to publish"

  local site="$ROOT/.build/pages"
  rm -rf "$site" && mkdir -p "$site"
  for game in "${games[@]}"; do
    game_dir "$game" >/dev/null
    cmd_build "$game"
    cp -r "$ROOT/games/$game/dist/web" "$site/$game"
  done
  touch "$site/.nojekyll"   # serve files as they are (no Jekyll processing)

  # https address of the repository (git@github.com:owner/repo.git -> https://github.com/owner/repo)
  local web; web="$(printf '%s' "$url" | sed -E 's#^git@([^:]+):#https://\1/#; s#\.git$##; s#^https://[^@/]+@#https://#')"
  php_run . -- php tools/pages-index.php .build/pages "$web" "${games[@]}"

  say "publishing ${games[*]} -> $remote $branch"
  git -C "$site" init -q -b "$branch"
  git -C "$site" add -A
  git -C "$site" commit -q -m "Browser builds: ${games[*]} ($(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo local))"
  git -C "$site" push -q -f "$url" "$branch"
  rm -rf "$site/.git"
  if [[ "$web" =~ ^https://github\.com/([^/]+)/([^/]+)$ ]]; then
    say "done: https://${BASH_REMATCH[1]}.github.io/${BASH_REMATCH[2]}/  (GitHub deploys it in ~1 min; first time: Settings > Pages > branch $branch)"
  else
    say "done: pushed to $remote $branch"
  fi
}

cmd_lint() {
  say "php -l (engine, skeleton, games)"
  php_run . -- sh -c 'find engine/src engine/bootstrap engine/tests skeleton games tools -name "*.php" -not -path "*/vendor/*" -not -path "*/.build/*" -print0 | xargs -0 -n1 php -l >/dev/null'
  say "forbidden words"
  bash tools/check-forbidden-words.sh
  say "lint OK"
}

cmd_doctor() {
  docker version --format 'docker {{.Server.Version}}' || die "docker is not running"
  docker image inspect "$DESKTOP_IMAGE" >/dev/null 2>&1 && echo "desktop image: ok" || echo "desktop image: missing (bin/jumphp setup)"
  [ -f "$ENGINE_DIR/php-web.wasm" ] && echo "wasm engine: ok ($ENGINE_DIR)" || echo "wasm engine: missing (bin/jumphp engine:build)"
  echo "display: DISPLAY=${DISPLAY:-} WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}"
  local xdg="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  [ -S "$xdg/pulse/native" ] && echo "sound: ok ($xdg/pulse/native)" || echo "sound: no PulseAudio/PipeWire socket (games run silent)"
  [ -d /dev/dri ] && echo "gpu: /dev/dri" || echo "gpu: none (software rendering)"
}

main() {
  # `bin/jumphp` alone in a project without a game yet (composer create-project, fresh clone): the wizard
  if [ $# -eq 0 ] && [ -t 0 ] && [ -t 1 ] && [ -z "${JUMPHP_GAME:-}" ]; then
    exec bash "$ROOT/tools/init.sh"
  fi
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    init) exec bash "$ROOT/tools/init.sh" "$@" ;;
    deploy:setup) exec bash "$ROOT/tools/init.sh" --deploy ;;
    github) exec bash "$ROOT/tools/init.sh" --github ;;
    server:setup) cmd_server_setup ;;
    server:logs) cmd_server_logs ;;
    server:traefik) cmd_server_traefik "$@" ;;
    update) cmd_update ;;
    engine:download) cmd_engine_download "$@" ;;
    engine:pack) cmd_engine_pack ;;
    runtime:build) cmd_runtime_build ;;
    runtime:download) cmd_runtime_download "$@" ;;
    setup) cmd_setup "$@" ;;
    engine:build) cmd_engine_build "$@" ;;
    new) cmd_new "$@" ;;
    install) local d; d="$(game_dir "${1:-}")"; php_run "$d" -- composer install --no-interaction ;;
    composer) local d; d="$(game_dir "${1:-}")"; shift; php_run "$d" -- composer "$@" ;;
    run) cmd_run "$@" ;;
    test) cmd_test "$@" ;;
    shot) cmd_shot "$@" ;;
    build) cmd_build "$@" ;;
    build:remote) cmd_build_remote "$@" ;;
    serve) cmd_serve "$@" ;;
    webshot) cmd_webshot "$@" ;;
    relay) cmd_relay "$@" ;;
    export:desktop) cmd_export_desktop "$@" ;;
    deploy) cmd_deploy "$@" ;;
    pages) cmd_pages "$@" ;;
    lint) cmd_lint ;;
    doctor) cmd_doctor ;;
    php) local d="${1:-.}"; shift || true; php_run "$d" -- php "$@" ;;
    help|-h|--help) usage ;;
    *) usage; die "unknown command: $cmd" ;;
  esac
}

main "$@"
